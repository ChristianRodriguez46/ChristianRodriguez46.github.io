\section{Purposes of Three Other Signals}

\begin{center}
\begin{tabular}{@{} l c p{9cm} @{}}
\toprule
\textbf{Signal} & \textbf{Default} & \textbf{Purpose} \\ \midrule
\texttt{SIGHUP}   & Term &
Hang-up detected on controlling terminal or loss of controlling process.  Often
prompts daemons to reload configuration. \\[4pt]
\texttt{SIGSEGV}  & Core &
Invalid memory reference (segmentation fault), e.g.\ dereferencing a bad
pointer. \\[4pt]
\texttt{SIGTERM}  & Term &
Polite request for a process to terminate; default signal used by
\texttt{kill}, permitting cleanup before exit. \\ \bottomrule
\end{tabular}
\end{center}

