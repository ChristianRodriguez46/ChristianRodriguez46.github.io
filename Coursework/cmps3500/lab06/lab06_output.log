% file: ~/cs3500/lab06/lab06.pl

mammal(kitty).
mammal(ratatat).
mammal(fido).

claws(kitty).

tail(ratatat).

bestfriend(fido).

feathers(tweety).

fur(A) :-
	mammal(A).

rat(A) :-
	fur(A),
	tail(A).

cat(A) :-
	claws(A),
	fur(A).

meows(A) :-
	cat(A).

bird(A) :-
	feathers(A).

dog(A) :-
	bestfriend(A),
	fur(A).

likes(A, B) :-
	dog(A),
	meows(B).
likes(A, B) :-
	cat(A),
	bird(B).
likes(A, B) :-
	cat(A),
	rat(B).

writeln(A) :-
	write(A),
	nl.

q1 :-
	findall(A, (likes(A, B), format('~n~w ~w', [A, B])), _).

end :-
	writeln(#),
	halt.

yes
| ?- q1.

fido kitty
kitty tweety
kitty ratatat

yes
| ?- halt.
