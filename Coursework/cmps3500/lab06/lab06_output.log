% file: ~/cs3500/lab06/lab06.pl

mammal(kitty).
mammal(ratatat).
mammal(fido).

claws(kitty).

tail(ratatat).

bestfriend(fido).

feathers(tweety).

fur(A) :-
	mammal(A).

rat(A) :-
	fur(A),
	tail(A).

cat(A) :-
	claws(A),
	fur(A).

meows(A) :-
	cat(A).

bird(A) :-
	feathers(A).

dog(A) :-
	bestfriend(A),
	fur(A).

likes(A, B) :-
	dog(A),
	meows(B).
likes(A, B) :-
	cat(A),
	bird(B).
likes(A, B) :-
	cat(A),
	rat(B).

writeln(A) :-
	write(A),
	nl.

max2(A, B, C) :-
	A >= B,
	C is A.
max2(A, B, C) :-
	A < B,
	C is B.

max3(A, B, C, D) :-
	max2(A, B, E),
	max2(E, C, D).

q1 :-
	findall(A, (likes(A, B), format('~n~w ~w', [A, B])), _).

q3 :-
	nl,
	write('Max(7,3,9)? '),
	findall(A, (max3(7, 3, 9, A), format('~w ~n', [A])), _).

end :-
	writeln(#),
	halt.

(1 ms) yes
| ?- q3
.

Max(7,3,9)? 9 

yes
| ?- end.
