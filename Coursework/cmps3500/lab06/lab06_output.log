male(clarence).
male(ron).
male(ken).
male(charlie).
male(irvin).

not(A) :-
	(   call(A) ->
	    fail
	;   true
	).

father(A, B) :-
	parent(A, B),
	male(A).

sister(A, B) :-
	female(A),
	female(B),
	parent(C, A),
	parent(C, B),
	A \== B.

sibling(A, B) :-
	parent(C, A),
	parent(C, B),
	A \== B.

closeRelative(A, B) :-
	parent(A, B).
closeRelative(A, B) :-
	parent(B, A).
closeRelative(A, B) :-
	sibling(A, B).

ancestor(A, B) :-
	parent(A, B).
ancestor(A, B) :-
	parent(A, C),
	ancestor(C, B).

cousin(A, B) :-
	parent(C, A),
	parent(D, B),
	sibling(C, D).

writeln(A) :-
	write(A),
	nl.

end :-
	writeln(#),
	halt.

q1 :-
	write('parent irvin?'),
	findall(A, (parent(A, irvin), format('~w ~n', [A])), _).

q2 :-
	write('sibling irvin?'),
	findall(A, (sibling(irvin, A), format('~w ', [A])), _).

q3 :-
	write('sisters?'),
	findall(A, (sister(A, B), format('~n~w ~w', [A, B])), _).

q4 :-
	write('close relatives? ').
q4 :-
	findall(A, (closeRelative(A, B), format('~n~w ~w', [A, B])), _).

