{
  "name": "breakaway",
  "version": "0.1.0",
  "private": true,
  "description": "Top-down arcade hockey shootout against an AI goalie. Plain JavaScript modules and Canvas 2D.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\" \"tests/stats/**/*.test.js\" \"tests/site/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --expose-gc --test \"tests/integration/**/*.test.js\"",
    "test:stats": "node --test \"tests/stats/**/*.test.js\"",
    "test:site": "node --test \"tests/site/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:responsive": "playwright test --grep @responsive",
    "test:perf": "playwright test --grep @perf --workers=1",
    "test:all": "npm test && npm run test:e2e",
    "check": "tsc -p jsconfig.json",
    "lint": "eslint src tests",
    "golden": "node tests/helpers/find-golden.mjs",
    "serve": "cd ../.. && python3 -m http.server 4101"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.56.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "typescript": "^6.0.0"
  }
}
